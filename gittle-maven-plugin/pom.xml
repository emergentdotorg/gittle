  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <configuration>
          <!--<goalPrefix>engage</goalPrefix>-->
          <extractors>
            <extractor>java-annotations</extractor>
          </extractors>
        </configuration>
        <executions>
          <execution>
            <id>generate-helpmojo</id>
            <goals>
              <goal>helpmojo</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.eclipse.sisu</groupId>
        <artifactId>sisu-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>index-project</id>
            <goals>
              <goal>main-index</goal>
              <goal>test-index</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>run-its</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-invoker-plugin</artifactId>
            <version>3.10.1</version>
            <executions>
              <execution>
                <id>integration-test</id>
                <goals>
                  <goal>install</goal>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
                <configuration>
                  <goals>
                    <goal>-ntp</goal>
                    <goal>verify</goal>
                  </goals>
                  <pomIncludes>
                    <pomInclude>*/pom.xml</pomInclude>
                  </pomIncludes>
                  <scope>runtime</scope>
                  <cloneClean>true</cloneClean>
                  <showErrors>true</showErrors>
                  <timeoutInSeconds>60</timeoutInSeconds>
                  <addTestClassPath>true</addTestClassPath>
                  <preBuildHookScript>setup</preBuildHookScript>
                  <postBuildHookScript>verify</postBuildHookScript>
                  <streamLogsOnFailures>true</streamLogsOnFailures>
                  <settingsFile>src/it/settings.xml</settingsFile>
                  <cloneProjectsTo>${project.build.directory}/its</cloneProjectsTo>
                  <localRepositoryPath>${project.build.directory}/local-invoker-repo</localRepositoryPath>
                  <environmentVariables>
                    <HOME>${project.build.directory}/its/tools</HOME>
                  </environmentVariables>
                  <properties>
                    <user.home>${project.build.directory}/its/tools</user.home>
                  </properties>
                  <extraArtifacts>
                    <artifact>junit:junit:3.8.1</artifact>
                  </extraArtifacts>
                  <scriptVariables>
                    <hello>goodbye</hello>
                  </scriptVariables>
                </configuration>
              </execution>
            </executions>
